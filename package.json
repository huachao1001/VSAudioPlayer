{
  "name": "audio-player",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.3",
  "publisher": "huachao",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/huachao1001/VSAudioPlayer"
  },
  "license": "MIT",
  "activationEvents": [
    "onCustomEditor:audioPlayer.audioEditor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "audioPlayer.audioEditor",
        "displayName": "Audio Player",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.wav"
          },
          {
            "filenamePattern": "*.mp3"
          },
          {
            "filenamePattern": "*.ogg"
          },
          {
            "filenamePattern": "*.flac"
          },
          {
            "filenamePattern": "*.m4a"
          },
          {
            "filenamePattern": "*.aac"
          },
          {
            "filenamePattern": "*.webm"
          },
          {
            "filenamePattern": "*.opus"
          },
          {
            "filenamePattern": "*.mp4"
          },
          {
            "filenamePattern": "*.pcm"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "audioPlayer.addFile",
        "title": "%command.addFile.title%",
        "category": "%command.category%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "audioPlayer.addFile",
          "group": "navigation@99",
          "when": "resourceExtname =~ /\\.(wav|mp3|ogg|flac|m4a|aac|webm|opus|mp4|pcm)$/i"
        }
      ]
    },
    "configuration": {
      "title": "Audio Player",
      "properties": {
        "audioPlayer.pcm.sampleRate": {
          "type": "number",
          "default": 16000,
          "minimum": 1,
          "description": "%config.pcm.sampleRate.desc%"
        },
        "audioPlayer.pcm.channels": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "description": "%config.pcm.channels.desc%"
        },
        "audioPlayer.pcm.dataType": {
          "type": "string",
          "default": "int16",
          "enum": [
            "int16",
            "fp32"
          ],
          "enumDescriptions": [
            "16-bit signed little-endian integer",
            "32-bit IEEE float"
          ],
          "description": "%config.pcm.dataType.desc%"
        }
      }
    },
    "languages": [
      {
        "id": "audio-player",
        "extensions": [
          ".wav",
          ".mp3",
          ".ogg",
          ".flac",
          ".m4a",
          ".aac",
          ".webm",
          ".opus",
          ".mp4",
          ".pcm"
        ],
        "aliases": [
          "Audio"
        ],
        "icon": {
          "light": "media/audio-icon-light.svg",
          "dark": "media/audio-icon-dark.svg"
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "gen:icon": "node scripts/svg2png.js",
    "package": "npm run build && npm version patch --no-git-tag-version && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.0",
    "wavesurfer.js": "^7.7.3"
  }
}
